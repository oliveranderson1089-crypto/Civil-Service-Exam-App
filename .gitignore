# Python 虚拟环境与缓存
.venv/
__pycache__/
*.pyc

# 运行时生成（含个人数据 / 密码，切勿上传）
app.db
# SQLite WAL/SHM：**必须一起忽略**。它们是尚未合并回主库的最近写入页，
# 内容跨全部业务表（users/notes/ai_chats…），而这个仓库是公开的 —— 提交上去等于
# 把一份用户数据快照推进公开历史。只写 app.db 的话 `git add -A` 照样会把它俩扫进来。
app.db-wal
app.db-shm
app.db-journal
config.json

# 导出/临时文件
*.pdf
*.log
.DS_Store

# 安卓构建产物（体积大，可重新生成）
android/build/
android/.gradle/
android/local.properties
*.keystore
*.idsig

# 用户上传 / 备份
uploads/
*.bak
*.bak.*

# 古诗文原始大数据(用 .gz 版)
data/classics.json
android/app/build/
desktop/build/
node_modules/
package-lock.json
uploads/realfig/
